---
// Typography-led feature list. No card boxes: hairline-divided rows,
// tight inside, generous between sections (handled by the page).
import Icon from "./Icon.astro";

interface Feature {
  icon: string;
  title: string;
  body: string;
}
interface Props {
  features: Feature[];
  columns?: 1 | 2;
}
const { features, columns = 2 } = Astro.props;
---

<ul class:list={["features", { single: columns === 1 }]}>
  {
    features.map((f) => (
      <li>
        <span class="ico"><Icon name={f.icon} size={18} /></span>
        <div>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 1fr;
    column-gap: var(--s8);
  }
  .features.single {
    grid-template-columns: 1fr;
    max-width: 720px;
  }
  li {
    display: flex;
    gap: var(--s4);
    padding: var(--s4) 0;
    border-top: 1px solid var(--corvo-divider);
  }
  li:last-child,
  li:nth-last-child(2):nth-child(odd) {
    border-bottom: 1px solid var(--corvo-divider);
  }
  .ico {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    margin-top: 2px;
    border-radius: 9px;
    background: var(--corvo-pill);
    border: 1px solid var(--corvo-divider);
    color: var(--corvo-text-icon);
    transition:
      color 140ms ease,
      border-color 140ms ease,
      background-color 140ms ease;
  }
  li:hover .ico {
    color: var(--corvo-accent);
    border-color: color-mix(in srgb, var(--corvo-accent) 35%, var(--corvo-divider));
    background: color-mix(in srgb, var(--corvo-selected) 45%, var(--corvo-pill));
  }
  h3 {
    font-size: 0.98rem;
    margin: 0 0 2px;
  }
  p {
    font-size: 0.9rem;
    line-height: 1.55;
    margin: 0;
  }
  @media (max-width: 760px) {
    .features {
      grid-template-columns: 1fr;
    }
    li:last-child {
      border-bottom: 1px solid var(--corvo-divider);
    }
    li:nth-last-child(2):nth-child(odd) {
      border-bottom: none;
    }
  }
</style>
