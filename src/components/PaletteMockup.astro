---
// Pure-CSS replica of the Corvo launcher, using the app's own palette.
import Icon from "./Icon.astro";

const rows = [
  { icon: "calc", title: "Calculator", sub: "Evaluate math expressions", acc: "= 12 × 4", accMono: true },
  { icon: "app", title: "Zed", sub: "Application", acc: "App" },
  { icon: "moon", title: "Toggle Dark Mode", sub: "System action", acc: "" },
  { icon: "snippet", title: "pr — PR description template", sub: "Snippet · pr", acc: "" },
  { icon: "folder", title: "corvo-ui", sub: "~/Dev/corvo/crates/corvo-ui", acc: "" },
];
const selected = 1;
const filters = ["All Types", "Text", "Links", "Images", "JSON"];
---

<div class="palette" role="img" aria-label="Corvo launcher window showing search results">
  <div class="search">
    <span class="glass"><Icon name="search" size={15} /></span>
    <span class="query">cal<span class="caret"></span></span>
    <span class="mode">Calculator</span>
  </div>
  <div class="rows">
    {
      rows.map((r, i) => (
        <div class:list={["row", { sel: i === selected }]}>
          <span class="rowicon">
            <Icon name={r.icon} size={14} />
          </span>
          <span class="title">{r.title}</span>
          <span class="sub">{r.sub}</span>
          {r.acc && <span class:list={["acc", { mono: r.accMono }]}>{r.acc}</span>}
        </div>
      ))
    }
  </div>
  <div class="statusbar">
    <div class="filters">
      {filters.map((f) => <span class:list={["pill", { on: f === "All Types" }]}>{f}</span>)}
    </div>
    <div class="hints">
      <span><kbd>↵</kbd> open</span>
      <span><kbd>⌘</kbd><kbd>K</kbd> commands</span>
    </div>
  </div>
</div>

<style>
  .palette {
    width: min(750px, 100%);
    margin: 0 auto;
    background: color-mix(in srgb, var(--corvo-surface) 90%, transparent);
    backdrop-filter: blur(20px);
    border: 1px solid var(--corvo-divider);
    border-radius: var(--radius-lg);
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.55);
    overflow: hidden;
    font-size: 13.5px;
    text-align: left;
  }
  .search {
    display: flex;
    align-items: center;
    gap: var(--s3);
    padding: 0 var(--s4);
    height: 56px;
    border-bottom: 1px solid var(--corvo-divider);
  }
  .glass {
    color: var(--corvo-text-icon);
    display: inline-flex;
  }
  .query {
    color: var(--corvo-text);
    font-size: 16px;
    display: inline-flex;
  }
  .caret {
    width: 2px;
    height: 19px;
    background: var(--corvo-accent);
    margin-left: 2px;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .mode {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--corvo-accent);
    background: var(--corvo-selected);
    border-radius: 6px;
    padding: 3px 8px;
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--s3);
    height: 40px;
    padding: 0 var(--s4);
  }
  .row.sel {
    background: var(--corvo-selected);
  }
  .rowicon {
    color: var(--corvo-text-icon);
    display: inline-flex;
    width: 18px;
    justify-content: center;
  }
  .title {
    color: var(--corvo-text);
    white-space: nowrap;
  }
  .row.sel .title {
    color: color-mix(in srgb, var(--corvo-accent) 70%, white);
  }
  .sub {
    color: var(--corvo-text-dim);
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .acc {
    margin-left: auto;
    color: var(--corvo-text-icon);
    font-size: 12px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .acc.mono {
    font-family: var(--font-mono);
    color: var(--corvo-accent);
  }
  .statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    padding: 10px 14px;
    border-top: 1px solid var(--corvo-divider);
    background: color-mix(in srgb, var(--corvo-menu) 94%, transparent);
  }
  .filters {
    display: flex;
    gap: 6px;
  }
  .pill {
    font-size: 11px;
    color: var(--corvo-text-icon);
    background: var(--corvo-pill);
    border-radius: 99px;
    padding: 3px 10px;
    white-space: nowrap;
  }
  .pill.on {
    color: var(--corvo-accent);
    background: var(--corvo-selected);
  }
  .hints {
    display: flex;
    gap: var(--s4);
    color: var(--corvo-text-dim);
    font-size: 11px;
    white-space: nowrap;
  }
  kbd {
    font-family: var(--font-mono);
    font-size: 10px;
    background: var(--corvo-keycap);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 1px 5px;
  }
  @media (max-width: 640px) {
    .sub,
    .filters,
    .hints span:last-child {
      display: none;
    }
  }
</style>
