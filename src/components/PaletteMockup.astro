---
// Interactive replica of the real Corvo window: large search field with
// placeholder, "Results" label, tall icon-tile rows, bottom action pill.
// Styles are global and pl- prefixed: JS-built rows carry no Astro scope id.
import Icon from "./Icon.astro";

interface Row {
  glyph?: string;
  tile?: string;
  globe?: boolean;
  title: string;
  sub?: string;
  tag: string;
  green?: boolean;
}

interface Preset {
  action: string;
  rows: Row[];
}

const app = (glyph: string, tile: string, title: string): Row => ({
  glyph,
  tile,
  title,
  tag: "Application",
});

const emptyState: Preset = {
  action: "Open Application",
  rows: [
    app("Z", "linear-gradient(135deg, #3d434c, #17191d)", "Zed"),
    app("C", "linear-gradient(135deg, #10a37f, #0b7a5f)", "ChatGPT"),
    app("A", "linear-gradient(135deg, #272f36, #14161a)", "Activity Monitor"),
    app("S", "linear-gradient(135deg, #3b82f6, #1d4ed8)", "Safari"),
    app("C", "linear-gradient(135deg, #f4f4f5, #d4d4d8)", "Calendar"),
    app("N", "linear-gradient(135deg, #facc15, #eab308)", "Notes"),
    app("A", "linear-gradient(135deg, #60a5fa, #2563eb)", "App Store"),
  ],
};

const presets: Record<string, Preset> = {
  cal: {
    action: "Open Application",
    rows: [
      app("=", "linear-gradient(135deg, #34d399, #0f766e)", "Calculator"),
      app("C", "linear-gradient(135deg, #f4f4f5, #d4d4d8)", "Calendar"),
      app("D", "linear-gradient(135deg, #3d434c, #17191d)", "Toggle Dark Mode"),
    ],
  },
  safari: {
    action: "Open Application",
    rows: [
      app("S", "linear-gradient(135deg, #3b82f6, #1d4ed8)", "Safari"),
      app("S", "linear-gradient(135deg, #60a5fa, #1e40af)", "Safari Technology Preview"),
      { globe: true, title: 'Search Google for "Safari"', tag: "Google" },
    ],
  },
  "kill :3000": {
    action: "Kill Process",
    rows: [
      { glyph: "⏻", tile: "linear-gradient(135deg, #ef4444, #991b1b)", title: "Kill process on :3000", sub: "PID 58491 · node", tag: "Action" },
      { glyph: "⏻", tile: "linear-gradient(135deg, #ef4444, #991b1b)", title: "Kill process on :8080", sub: "PID 49201 · vite", tag: "Action" },
      { glyph: "≡", tile: "linear-gradient(135deg, #3d434c, #17191d)", title: "Inspect all open ports", tag: "Action" },
    ],
  },
  emoji: {
    action: "Paste to Aside",
    rows: [],
  },
  "window left": {
    action: "Tile Window",
    rows: [
      { glyph: "◧", tile: "linear-gradient(135deg, #3d434c, #17191d)", title: "Tile Window: Left Half", tag: "⌥⌘←" },
      { glyph: "◨", tile: "linear-gradient(135deg, #3d434c, #17191d)", title: "Tile Window: Right Half", tag: "⌥⌘→" },
      { glyph: "⛶", tile: "linear-gradient(135deg, #3d434c, #17191d)", title: "Tile Window: Maximize", tag: "⌃⌥↵" },
    ],
  },
};

const fallback = (q: string): Preset => ({
  action: "Open Application",
  rows: [
    { globe: true, title: `Search Google for "${q}"`, tag: "Google" },
    { globe: true, title: `Search DuckDuckGo for "${q}"`, tag: "DuckDuckGo" },
  ],
});

const EMOJI = [
  "😀", "😃", "😄", "😁", "😆", "😅", "🤣", "😂",
  "🙂", "🙃", "🫠", "😉", "😊", "😇", "🥰", "😍",
  "🤩", "😘", "😗", "😚", "😙", "🥲", "😋", "😛",
];

const chips = ["cal", "safari", "24 * 7", "kill :3000", "emoji 🚀", "window left"];
---

<div class="pl-container" data-reveal data-ambient>
  <div class="pl-ambient" aria-hidden="true"></div>

  <div class="pl-chips" aria-label="Quick launcher examples">
    <span class="pl-chips-label">Try a query</span>
    {chips.map((c) => (
      <button type="button" class="pl-chip" data-query={c === "emoji 🚀" ? "emoji" : c}>
        <code>{c}</code>
      </button>
    ))}
  </div>

  <div class="pl-window" role="region" aria-label="Interactive Corvo launcher replica">
    <div class="pl-search">
      <span class="pl-back" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m14.5 5.5-6.5 6.5 6.5 6.5"/></svg>
      </span>
      <span class="pl-glass"><Icon name="search" size={21} /></span>
      <input
        type="text"
        class="pl-input"
        id="corvo-launcher-input"
        value=""
        placeholder="Search for apps and commands..."
        autocomplete="off"
        spellcheck="false"
        aria-label="Corvo search query"
      />
      <span class="pl-cats" aria-hidden="true">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="4.5" width="7" height="6.5" rx="1.5"/><rect x="13" y="4.5" width="7" height="6.5" rx="1.5"/><rect x="4" y="13" width="7" height="6.5" rx="1.5"/><rect x="13" y="13" width="7" height="6.5" rx="1.5"/></svg>
        All Categories
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9.5 6 6 6-6"/></svg>
      </span>
    </div>

    <div class="pl-results-label">Results</div>

    <div class="pl-rows" id="corvo-rows-list" role="listbox" aria-label="Search results">
      {emptyState.rows.map((r, i) => (
        <div class:list={["pl-row", { sel: i === 0 }]} role="option" aria-selected={i === 0 ? "true" : "false"} tabindex="0">
          <span class="pl-tile" style={`background:${r.tile}`}>{r.glyph}</span>
          <span class="pl-title">{r.title}</span>
          {r.sub && <span class="pl-sub">{r.sub}</span>}
          <span class="pl-tag">{r.tag}</span>
        </div>
      ))}
    </div>

    <div class="pl-grid" id="corvo-emoji-grid" aria-hidden="true">
      {EMOJI.map((e, i) => (
        <span class:list={["pl-emoji-tile", { sel: i === 0 }]}>{e}</span>
      ))}
    </div>

    <div class="pl-statusbar">
      <span class="pl-sb-left">
        <span class="pl-menu-btn" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </span>
        <span class="pl-emoji-caption" aria-hidden="true">
          <strong>grinning face</strong>
          <span class="pl-cap-sep">·</span>
          Smileys &amp; Emotion
        </span>
      </span>
      <div class="pl-action-pill">
        <span class="pl-action-label" id="corvo-action-label">{emptyState.action}</span>
        <kbd class="pl-mini-key">⏎</kbd>
        <span class="pl-pill-sep" aria-hidden="true"></span>
        <span class="pl-actions-word">Actions</span>
        <kbd class="pl-mini-key">⌘</kbd>
        <kbd class="pl-mini-key">K</kbd>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ presets, emptyState, fallback }}>
  (() => {
    const input = document.getElementById("corvo-launcher-input");
    const actionLabel = document.getElementById("corvo-action-label");
    const rowsList = document.getElementById("corvo-rows-list");
    const emojiGrid = document.getElementById("corvo-emoji-grid");
    const windowEl = document.querySelector(".pl-window");
    const chips = document.querySelectorAll(".pl-chips .pl-chip");
    if (!input || !actionLabel || !rowsList || !emojiGrid || !windowEl) return;

    const HOME_PLACEHOLDER = "Search for apps and commands...";
    const EMOJI_PLACEHOLDER = "Search emoji and symbols...";

    function setEmojiMode(on) {
      windowEl.classList.toggle("emoji-mode", on);
      input.placeholder = on ? EMOJI_PLACEHOLDER : HOME_PLACEHOLDER;
    }

    const GLOBE_SVG = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17"/><path d="M12 3.5c2.5 2.3 3.8 5.2 3.8 8.5s-1.3 6.2-3.8 8.5c-2.5-2.3-3.8-5.2-3.8-8.5s1.3-6.2 3.8-8.5Z"/></svg>';

    // Deterministic shunting-yard evaluator. Returns null when the
    // expression does not reduce to one finite number.
    function calcResult(expr) {
      if (!/^[\d\s+\-*/%^().]+$/.test(expr)) return null;
      const tokens = expr.match(/\d+\.?\d*|[+\-*/%^()]/g);
      if (!tokens) return null;
      const prec = { "+": 1, "-": 1, "*": 2, "/": 2, "%": 2, "^": 3 };
      const out = [];
      const ops = [];
      let prev = null;
      for (const t of tokens) {
        if (/\d/.test(t)) {
          out.push(parseFloat(t));
        } else if (t === "(") {
          ops.push(t);
        } else if (t === ")") {
          while (ops.length && ops[ops.length - 1] !== "(") out.push(ops.pop());
          if (!ops.length) return null;
          ops.pop();
        } else {
          if ((t === "-" || t === "+") && (prev === null || prev === "(" || prec[prev])) {
            out.push(0);
          }
          while (ops.length && prec[ops[ops.length - 1]] >= prec[t] && t !== "^") out.push(ops.pop());
          ops.push(t);
        }
        prev = t;
      }
      while (ops.length) {
        const op = ops.pop();
        if (op === "(") return null;
        out.push(op);
      }
      const st = [];
      for (const t of out) {
        if (typeof t === "number") {
          st.push(t);
        } else {
          const b = st.pop();
          const a = st.pop();
          if (a === undefined || b === undefined) return null;
          st.push(
            t === "+" ? a + b
            : t === "-" ? a - b
            : t === "*" ? a * b
            : t === "/" ? a / b
            : t === "%" ? a % b
            : Math.pow(a, b),
          );
        }
      }
      if (st.length !== 1 || typeof st[0] !== "number" || !Number.isFinite(st[0])) return null;
      return String(parseFloat(st[0].toFixed(10)));
    }

    const isArithmetic = (q) =>
      /^[\d\s+\-*/%^().]+$/.test(q) && /\d/.test(q) && /[+\-*/%^]/.test(q);

    function buildRow(r, idx) {
      const row = document.createElement("div");
      row.className = "pl-row" + (idx === 0 ? " sel" : "");
      row.setAttribute("role", "option");
      row.setAttribute("aria-selected", idx === 0 ? "true" : "false");
      row.tabIndex = 0;

      if (r.globe) {
        const icon = document.createElement("span");
        icon.className = "pl-plain-icon";
        icon.innerHTML = GLOBE_SVG;
        row.appendChild(icon);
      } else {
        const tile = document.createElement("span");
        tile.className = "pl-tile";
        tile.style.background = r.tile;
        tile.textContent = r.glyph;
        row.appendChild(tile);
      }

      const title = document.createElement("span");
      title.className = "pl-title";
      title.textContent = r.title;
      row.appendChild(title);

      if (r.sub) {
        const sub = document.createElement("span");
        sub.className = "pl-sub";
        sub.textContent = r.sub;
        row.appendChild(sub);
      }

      const tag = document.createElement("span");
      tag.className = "pl-tag" + (r.green ? " green" : "");
      tag.textContent = r.tag;
      row.appendChild(tag);

      return row;
    }

    function buildWebRow(title, tag) {
      return buildRow({ globe: true, title, tag }, 1);
    }

    function renderCalc(expr, result) {
      actionLabel.textContent = "Copy Answer";
      rowsList.innerHTML = "";

      const row = document.createElement("div");
      row.className = "pl-row calc sel";
      row.setAttribute("role", "option");
      row.setAttribute("aria-selected", "true");
      row.tabIndex = 0;

      const exprCell = document.createElement("span");
      exprCell.className = "pl-calc-cell";
      const exprVal = document.createElement("span");
      exprVal.className = "pl-calc-big";
      exprVal.textContent = expr;
      const exprBadge = document.createElement("span");
      exprBadge.className = "pl-calc-badge";
      exprBadge.textContent = "Expression";
      exprCell.appendChild(exprVal);
      exprCell.appendChild(exprBadge);

      const arrow = document.createElement("span");
      arrow.className = "pl-calc-arrow";
      arrow.innerHTML = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"/><path d="m13.5 6.5 5.5 5.5-5.5 5.5"/></svg>';

      const resCell = document.createElement("span");
      resCell.className = "pl-calc-cell";
      const resVal = document.createElement("span");
      resVal.className = "pl-calc-big green";
      resVal.textContent = result;
      const resBadge = document.createElement("span");
      resBadge.className = "pl-calc-badge green-b";
      resBadge.textContent = "Result";
      resCell.appendChild(resVal);
      resCell.appendChild(resBadge);

      row.appendChild(exprCell);
      row.appendChild(arrow);
      row.appendChild(resCell);
      rowsList.appendChild(row);

      rowsList.appendChild(buildWebRow(`Search Google for "${expr}"`, "Google"));
      rowsList.appendChild(buildWebRow(`Search DuckDuckGo for "${expr}"`, "DuckDuckGo"));
    }

    function renderEmoji() {
      actionLabel.textContent = "Paste to Aside";
      rowsList.innerHTML = "";
      setEmojiMode(true);
    }

    function renderRows(rows, action) {
      actionLabel.textContent = action;
      rowsList.innerHTML = "";
      rows.forEach((r, idx) => rowsList.appendChild(buildRow(r, idx)));
      setEmojiMode(false);
    }

    rowsList.addEventListener("mousemove", (e) => {
      const row = e.target.closest(".pl-row");
      if (!row || row.classList.contains("sel")) return;
      rowsList.querySelectorAll(".pl-row").forEach((el) => {
        el.classList.remove("sel");
        el.setAttribute("aria-selected", "false");
      });
      row.classList.add("sel");
      row.setAttribute("aria-selected", "true");
    });

    function applyQuery(q) {
      q = q.trim();
      chips.forEach((chip) => {
        chip.classList.toggle("active", chip.getAttribute("data-query") === q);
      });

      if (q === "") {
        renderRows(emptyState.rows, emptyState.action);
        return;
      }
      if (isArithmetic(q)) {
        const result = calcResult(q);
        if (result !== null) {
          renderCalc(q, result);
          return;
        }
      }
      const lowerNow = q.toLowerCase();
      if (lowerNow.includes("emoji")) {
        renderEmoji();
        return;
      }
      if (presets[q]) {
        renderRows(presets[q].rows, presets[q].action);
        return;
      }
      const lower = q.toLowerCase();
      for (const [key, data] of Object.entries(presets)) {
        if (key.includes(lower) || lower.includes(key)) {
          renderRows(data.rows, data.action);
          return;
        }
      }
      renderRows(fallback(q).rows, fallback(q).action);
    }

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        input.value = chip.getAttribute("data-query") || "";
        applyQuery(input.value);
      });
    });

    input.addEventListener("input", (e) => applyQuery(e.target.value));

    input.addEventListener("keydown", (e) => {
      const rows = Array.from(rowsList.querySelectorAll(".pl-row"));
      if (!rows.length) return;
      const currentIdx = rows.findIndex((r) => r.classList.contains("sel"));

      if (e.key === "ArrowDown") {
        e.preventDefault();
        const nextIdx = currentIdx >= 0 ? (currentIdx + 1) % rows.length : 0;
        rows.forEach((r, i) => {
          r.classList.toggle("sel", i === nextIdx);
          r.setAttribute("aria-selected", i === nextIdx ? "true" : "false");
        });
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        const activeIdx = currentIdx >= 0 ? currentIdx : 0;
        const prevIdx = (activeIdx - 1 + rows.length) % rows.length;
        rows.forEach((r, i) => {
          r.classList.toggle("sel", i === prevIdx);
          r.setAttribute("aria-selected", i === prevIdx ? "true" : "false");
        });
      }
    });
  })();
</script>

<style is:global>
  .pl-container {
    position: relative;
    width: 100%;
    max-width: 780px;
    margin: 0 auto;
  }

  .pl-ambient {
    position: absolute;
    inset: -40px 4% auto;
    height: 220px;
    background:
      radial-gradient(ellipse 55% 60% at 30% 40%, rgba(52, 211, 153, 0.13), transparent 70%),
      radial-gradient(ellipse 40% 55% at 78% 30%, rgba(96, 165, 250, 0.08), transparent 70%);
    filter: blur(42px);
    pointer-events: none;
    z-index: 0;
    animation: palette-aurora 11s var(--ease-in-out) infinite alternate;
    animation-play-state: paused;
  }

  .pl-container[data-ambient-active] .pl-ambient {
    animation-play-state: running;
  }

  @keyframes palette-aurora {
    0% { opacity: 0.55; transform: translate3d(-4%, 2%, 0) scale(0.92); }
    48% { opacity: 1; transform: translate3d(5%, -6%, 0) scale(1.08); }
    100% { opacity: 0.64; transform: translate3d(11%, 2%, 0) scale(0.96); }
  }

  .pl-chips {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .pl-chips-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--corvo-text-icon);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-right: 4px;
  }

  .pl-chip {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 3px 8px;
    cursor: pointer;
    transition: background-color 120ms var(--ease-out), border-color 120ms var(--ease-out);
  }

  .pl-chip code {
    background: transparent;
    border: none;
    padding: 0;
    font-size: 0.75rem;
    color: var(--corvo-text-dim);
  }

  .pl-chip:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.18);
  }

  .pl-chip:hover code {
    color: var(--corvo-text);
  }

  .pl-chip.active {
    background: var(--corvo-selected);
    border-color: color-mix(in srgb, var(--corvo-accent) 45%, var(--corvo-divider));
  }

  .pl-chip.active code {
    color: var(--corvo-accent);
    font-weight: 600;
  }

  /* ------------- window ------------- */
  .pl-window {
    position: relative;
    z-index: 1;
    width: 100%;
    background: rgba(17, 18, 20, 0.86);
    backdrop-filter: blur(26px) saturate(160%);
    -webkit-backdrop-filter: blur(26px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top-color: rgba(255, 255, 255, 0.18);
    border-radius: 18px;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.6),
      0 40px 90px -18px rgba(0, 0, 0, 0.8),
      0 0 70px -24px rgba(52, 211, 153, 0.18);
    overflow: hidden;
    text-align: left;
    display: flex;
    flex-direction: column;
  }

  .pl-search {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 24px 16px;
  }

  .pl-glass {
    color: var(--corvo-text-icon);
    display: inline-flex;
    flex: none;
  }

  .pl-input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: var(--corvo-text);
    caret-color: var(--corvo-accent);
    font-family: inherit;
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.01em;
    padding: 0;
  }

  .pl-input::placeholder {
    color: var(--corvo-text-icon);
    opacity: 0.9;
  }

  .pl-input::selection {
    background: var(--corvo-selected);
    color: var(--corvo-text);
  }

  .pl-results-label {
    padding: 2px 24px 8px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--corvo-text-icon);
  }

  .pl-rows {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 10px 10px;
    min-height: 372px;
  }

  .pl-row {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 50px;
    padding: 0 10px;
    border-radius: 10px;
    cursor: pointer;
    user-select: none;
    transition: background-color 100ms var(--ease-out), color 100ms ease;
  }

  .pl-row.sel {
    background: var(--corvo-selected);
  }

  .pl-tile {
    width: 30px;
    height: 30px;
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 1px 2px rgba(0, 0, 0, 0.4);
  }

  .pl-title {
    color: var(--corvo-text);
    font-size: 15.5px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pl-row.sel .pl-title {
    font-weight: 600;
  }

  .pl-sub {
    color: var(--corvo-text-icon);
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pl-tag {
    margin-left: auto;
    flex: none;
    color: var(--corvo-text-icon);
    font-size: 14px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .pl-row.sel .pl-tag {
    color: rgba(255, 255, 255, 0.85);
  }

  .pl-tag.green {
    color: var(--corvo-accent);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .pl-plain-icon {
    width: 30px;
    flex: none;
    display: inline-flex;
    justify-content: center;
    color: var(--corvo-text-icon);
  }

  .pl-row.sel .pl-plain-icon {
    color: var(--corvo-accent);
  }

  /* calculator display row */
  .pl-row.calc {
    min-height: 88px;
