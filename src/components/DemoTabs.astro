---
// Interactive product demo: radio-driven tabs, zero JS.
// Panels replicate the launcher chrome in the app's own palette.
import Icon from "./Icon.astro";
---

<div class="demo">
  <input type="radio" name="demo" id="demo-clipboard" checked />
  <input type="radio" name="demo" id="demo-windows" />
  <input type="radio" name="demo" id="demo-calc" />
  <input type="radio" name="demo" id="demo-snippets" />

  <div class="tablist">
    <label for="demo-clipboard">Clipboard</label>
    <label for="demo-windows">Windows</label>
    <label for="demo-calc">Calculator</label>
    <label for="demo-snippets">Snippets</label>
  </div>

  <div class="palette" role="group" aria-label="Corvo launcher demo">
    <!-- Clipboard -->
    <div class="panel p-clip">
      <div class="search">
        <span class="glass"><Icon name="search" size={15} /></span>
        <span class="query">color<span class="caret"></span></span>
        <span class="mode">Clipboard</span>
      </div>
      <div class="rows">
        <div class="row sel">
          <span class="swatch"></span>
          <span class="title mono">#34D399</span>
          <span class="sub">Color · 2m ago</span>
        </div>
        <div class="row">
          <span class="rowicon"><Icon name="link" size={14} /></span>
          <span class="title mono trunc">github.com/diegoleteliers10/corvo</span>
          <span class="sub">Link · 5m</span>
        </div>
        <div class="row">
          <span class="rowicon"><Icon name="snippet" size={14} /></span>
          <span class="title mono trunc">{'{ "name": "corvo", "fast": true }'}</span>
          <span class="sub">JSON · 12m</span>
        </div>
        <div class="row">
          <span class="rowicon"><Icon name="clipboard" size={14} /></span>
          <span class="title mono trunc">brew install diegoleteliers10/corvo</span>
          <span class="sub">Text · 1h</span>
        </div>
        <div class="row">
          <span class="thumb"></span>
          <span class="title">Screenshot.png</span>
          <span class="sub">Image · 512×512</span>
        </div>
      </div>
      <div class="statusbar">
        <div class="filters">
          <span class="pill on">All Types</span>
          <span class="pill">Text</span>
          <span class="pill">Links</span>
          <span class="pill">Images</span>
          <span class="pill">JSON</span>
        </div>
        <span class="hints"><kbd>↵</kbd> paste</span>
      </div>
    </div>

    <!-- Windows -->
    <div class="panel p-win">
      <div class="desktop">
        <div class="tile focus">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="tname">Zed</span>
        </div>
        <div class="stack">
          <div class="tile">
            <span class="dots"><i></i><i></i><i></i></span>
            <span class="tname">SPEC.md — corvo</span>
          </div>
          <div class="tile">
            <span class="dots"><i></i><i></i><i></i></span>
            <span class="tname mono">cargo build --release</span>
          </div>
        </div>
      </div>
      <div class="statusbar">
        <div class="filters">
          <span class="pill on">Left half</span>
          <span class="pill">Quarters</span>
          <span class="pill">Thirds</span>
          <span class="pill">Maximize</span>
        </div>
        <span class="hints"><kbd>⌥</kbd><kbd>←</kbd> tile left</span>
      </div>
    </div>

    <!-- Calculator -->
    <div class="panel p-calc">
      <div class="search">
        <span class="glass"><Icon name="calc" size={15} /></span>
        <span class="query">1920/2.25<span class="caret"></span></span>
        <span class="mode">Calculator</span>
      </div>
      <div class="calc-body">
        <div class="result mono">853.3333</div>
        <div class="history">
          <div class="hrow mono"><span>512 × 2</span><span class="dim">= 1 024</span></div>
          <div class="hrow mono"><span>2^10</span><span class="dim">= 1 024</span></div>
          <div class="hrow mono"><span>1024 / 8</span><span class="dim">= 128</span></div>
        </div>
      </div>
      <div class="statusbar">
        <span class="hints"><kbd>↵</kbd> copy result</span>
      </div>
    </div>

    <!-- Snippets -->
    <div class="panel p-snip">
      <div class="search">
        <span class="glass"><Icon name="snippet" size={15} /></span>
        <span class="query">pr<span class="caret"></span></span>
        <span class="mode">Snippets</span>
      </div>
      <div class="rows">
        <div class="row sel">
          <span class="rowicon"><Icon name="snippet" size={14} /></span>
          <span class="title">PR description template</span>
          <span class="sub">keyword · pr</span>
        </div>
      </div>
      <pre class="body mono">{`## What
- Native command crates, registered at link time

## Why
- No plugin runtime, no cold starts`}</pre>
      <div class="statusbar">
        <span class="hints"><kbd>↵</kbd> insert</span>
      </div>
    </div>
  </div>
</div>

<style>
  .demo {
    max-width: 750px;
    margin: 0 auto;
  }
  .demo input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .tablist {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-bottom: var(--s5);
  }
  label {
    font-size: 0.85rem;
    color: var(--corvo-text-dim);
    background: var(--corvo-pill);
    border: 1px solid var(--corvo-divider);
    border-radius: 99px;
    padding: 7px 16px;
    cursor: pointer;
    user-select: none;
    transition:
      color 140ms ease,
      border-color 140ms ease,
      background-color 140ms ease;
  }
  label:hover {
    color: var(--corvo-text);
    border-color: var(--corvo-keycap);
  }

  /* frame shared by panels */
  .palette {
    background: color-mix(in srgb, var(--corvo-surface) 92%, transparent);
    border: 1px solid var(--corvo-divider);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    font-size: 13.5px;
  }
  .panel {
    display: none;
  }

  /* tab switching + focus */
  #demo-clipboard:checked ~ .palette .p-clip,
  #demo-windows:checked ~ .palette .p-win,
  #demo-calc:checked ~ .palette .p-calc,
  #demo-snippets:checked ~ .palette .p-snip {
    display: block;
  }
  #demo-clipboard:checked ~ .tablist label[for="demo-clipboard"],
  #demo-windows:checked ~ .tablist label[for="demo-windows"],
  #demo-calc:checked ~ .tablist label[for="demo-calc"],
  #demo-snippets:checked ~ .tablist label[for="demo-snippets"] {
    color: var(--corvo-accent);
    background: var(--corvo-selected);
    border-color: color-mix(in srgb, var(--corvo-accent) 35%, var(--corvo-divider));
  }
  input:focus-visible ~ .tablist label[for="demo-clipboard"],
  input:focus-visible ~ .tablist label[for="demo-windows"],
  input:focus-visible ~ .tablist label[for="demo-calc"],
  input:focus-visible ~ .tablist label[for="demo-snippets"] {
    outline: 2px solid var(--corvo-accent);
    outline-offset: 2px;
  }

  .search {
    display: flex;
    align-items: center;
    gap: var(--s3);
    padding: 0 var(--s4);
    height: 52px;
    border-bottom: 1px solid var(--corvo-divider);
  }
  .glass {
    color: var(--corvo-text-icon);
    display: inline-flex;
  }
  .query {
    color: var(--corvo-text);
    font-size: 15px;
    display: inline-flex;
  }
  .caret {
    width: 2px;
    height: 18px;
    background: var(--corvo-accent);
    margin-left: 2px;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .mode {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--corvo-accent);
    background: var(--corvo-selected);
    border-radius: 6px;
    padding: 3px 8px;
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--s3);
    height: 38px;
    padding: 0 var(--s4);
  }
  .row.sel {
    background: var(--corvo-selected);
  }
  .rowicon {
    color: var(--corvo-text-icon);
    display: inline-flex;
    width: 18px;
    justify-content: center;
  }
  .title {
    color: var(--corvo-text);
    white-space: nowrap;
  }
  .row.sel .title {
    color: color-mix(in srgb, var(--corvo-accent) 70%, white);
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .trunc {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sub {
    margin-left: auto;
    color: var(--corvo-text-icon);
    font-size: 11.5px;
    white-space: nowrap;
  }
  .swatch {
    width: 16px;
    height: 16px;
    border-radius: 5px;
    background: var(--corvo-accent);
    border: 1px solid rgba(255, 255, 255, 0.15);
    flex: none;
  }
  .thumb {
    width: 22px;
    height: 16px;
    border-radius: 4px;
    background: linear-gradient(135deg, var(--corvo-keycap), var(--corvo-selected));
    border: 1px solid var(--corvo-divider);
    flex: none;
  }
  .statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    padding: 10px 14px;
    border-top: 1px solid var(--corvo-divider);
    background: color-mix(in srgb, var(--corvo-menu) 94%, transparent);
  }
  .filters {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .pill {
    font-size: 11px;
    color: var(--corvo-text-icon);
    background: var(--corvo-pill);
    border-radius: 99px;
    padding: 3px 10px;
    white-space: nowrap;
  }
  .pill.on {
    color: var(--corvo-accent);
    background: var(--corvo-selected);
  }
  .hints {
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--corvo-text-icon);
    font-size: 11px;
    white-space: nowrap;
  }
  kbd {
    font-family: var(--font-mono);
    font-size: 10px;
    background: var(--corvo-keycap);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 1px 5px;
  }

  /* windows panel */
  .desktop {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s3);
    padding: var(--s6) var(--s6) var(--s7);
    background:
      radial-gradient(80% 60% at 50% 0%, rgba(52, 211, 153, 0.04), transparent),
      #0b0c0d;
    min-height: 300px;
  }
  .tile {
    display: flex;
    align-items: center;
    gap: var(--s2);
    padding: 0 var(--s3);
    height: 34px;
    background: var(--corvo-surface);
    border: 1px solid var(--corvo-divider);
    border-radius: 9px;
  }
  .tile.focus {
    border-color: var(--corvo-accent);
  }
  .stack {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: var(--s3);
  }
  .stack .tile {
    height: auto;
    align-items: flex-start;
    padding-top: var(--s2);
  }
  .dots {
    display: inline-flex;
    gap: 4px;
  }
  .dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--corvo-keycap);
  }
  .tname {
    font-size: 11.5px;
    color: var(--corvo-text-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* calculator panel */
  .calc-body {
    padding: var(--s7) var(--s5) var(--s6);
    text-align: center;
  }
  .result {
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    color: var(--corvo-text);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    margin-bottom: var(--s6);
  }
  .history {
    max-width: 260px;
    margin: 0 auto;
    display: grid;
    gap: var(--s2);
  }
  .hrow {
    display: flex;
    justify-content: space-between;
    font-size: 12.5px;
    color: var(--corvo-text);
    font-variant-numeric: tabular-nums;
  }
  .hrow .dim {
    color: var(--corvo-text-icon);
  }

  /* snippets panel */
  .body {
    margin: 0;
    padding: var(--s4) var(--s5);
    color: var(--corvo-text-dim);
    font-size: 12.5px;
    line-height: 1.7;
    border-top: 1px solid var(--corvo-divider);
    min-height: 168px;
  }

  @media (max-width: 640px) {
    .sub,
    .filters {
      display: none;
    }
    .desktop {
      padding: var(--s4);
      min-height: 220px;
    }
  }
</style>
