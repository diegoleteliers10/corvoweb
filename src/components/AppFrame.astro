---
// Signature app-window frame for real Corvo captures.
// framed: hairline plate with 12px padding. bare: image floats free
// with shadow and reflection only (hero).
interface Props {
  src: string;
  alt: string;
  eager?: boolean;
  variant?: "framed" | "bare";
}
const { src, alt, eager = false, variant = "framed" } = Astro.props;
---

<figure class="app-frame">
  <span class="frame-glow" aria-hidden="true"></span>
  <div class:list={["frame-window", { bare: variant === "bare" }]}>
    <img src={src} alt={alt} loading={eager ? "eager" : "lazy"} width="1504" height="954" decoding="async" />
  </div>
</figure>

<style>
  .app-frame {
    position: relative;
    margin: 0;
    min-width: 0;
  }

  .frame-glow {
    position: absolute;
    inset: -8% -6% -18%;
    background: radial-gradient(ellipse 60% 55% at 50% 42%, rgba(52, 211, 153, 0.22), transparent 70%);
    filter: blur(34px);
    pointer-events: none;
  }

  .frame-window {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: #000;
    padding: 12px;
    border: 1px solid rgba(255, 255, 255, 0.11);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.09),
      0 0 0 1px rgba(0, 0, 0, 0.55),
      0 42px 88px -22px rgba(0, 0, 0, 0.82),
      0 12px 34px -12px rgba(0, 0, 0, 0.6);
    -webkit-box-reflect: below 14px linear-gradient(transparent 62%, rgba(255, 255, 255, 0.1) 100%);
    margin-bottom: 44px;
  }

  .frame-window img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
  }

  .frame-window.bare {
    padding: 0;
    background: transparent;
    border: none;
    box-shadow: none;
    border-radius: 8px;
    overflow: visible;
  }

  .frame-window.bare img {
    border-radius: 8px;
    box-shadow:
      0 42px 88px -22px rgba(0, 0, 0, 0.82),
      0 12px 34px -12px rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 640px) {
    .frame-window {
      -webkit-box-reflect: below 8px linear-gradient(transparent 70%, rgba(255, 255, 255, 0.07) 100%);
      margin-bottom: 24px;
    }
  }
</style>
