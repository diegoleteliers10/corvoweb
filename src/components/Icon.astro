---
// Authored stroke icon set. 24x24 viewBox, 1.5px stroke, round caps.
interface Props {
  name: string;
  size?: number;
}
const { name, size = 20 } = Astro.props;

const paths: Record<string, string> = {
  // app window with a top bar
  app: '<rect x="3.5" y="4.5" width="17" height="15" rx="2.5"/><path d="M3.5 9h17"/><path d="M6.5 6.75h.01M9 6.75h.01"/>',
  // magnifier
  search: '<circle cx="11" cy="11" r="6"/><path d="M15.5 15.5 20 20"/>',
  // clipboard
  clipboard: '<rect x="5" y="4.5" width="14" height="16" rx="2.5"/><path d="M9 4.5a3 3 0 0 1 6 0"/><path d="M9 11h6M9 15h4"/>',
  // calculator
  calc: '<rect x="5" y="3.5" width="14" height="17" rx="2.5"/><path d="M8.5 7.5h7"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01M8.5 15.5h.01M12 15.5h.01M15.5 15.5h.01"/>',
  // text snippet (cursor in brackets)
  snippet: '<path d="M8 4.5H6A1.5 1.5 0 0 0 4.5 6v3L3 12l1.5 3v3A1.5 1.5 0 0 0 6 19.5h2"/><path d="M16 4.5h2A1.5 1.5 0 0 1 19.5 6v3l1.5 3-1.5 3v3a1.5 1.5 0 0 1-1.5 1.5h-2"/><path d="M12 9v6"/>',
  // emoji face
  emoji: '<circle cx="12" cy="12" r="8.5"/><path d="M8.75 14a4.2 4.2 0 0 0 6.5 0"/><path d="M9.25 9.75h.01M14.75 9.75h.01"/>',
  // arrow-right (quicklinks)
  link: '<path d="M4 12h15"/><path d="m13.5 6.5 5.5 5.5-5.5 5.5"/>',
  // sliders (system)
  sliders: '<path d="M5 8h8M17 8h2M5 16h2M11 16h8"/><circle cx="15" cy="8" r="2"/><circle cx="9" cy="16" r="2"/>',
  // grid of tiles (window management)
  grid: '<rect x="4" y="4.5" width="7" height="6.5" rx="1.5"/><rect x="13" y="4.5" width="7" height="6.5" rx="1.5"/><rect x="4" y="13" width="7" height="6.5" rx="1.5"/><rect x="13" y="13" width="7" height="6.5" rx="1.5"/>',
  // refresh (updater)
  refresh: '<path d="M19.5 12a7.5 7.5 0 1 1-2.2-5.3"/><path d="M19.5 3.5V7H16"/>',
  // moon (dark mode)
  moon: '<path d="M20 13.5A8 8 0 0 1 10.5 4 8 8 0 1 0 20 13.5Z"/>',
  // folder (files)
  folder: '<path d="M3.5 7A2 2 0 0 1 5.5 5h4l2 2.5h7a2 2 0 0 1 2 2V17a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2Z"/>',
  // sparkle (snippets alt)
  sparkle: '<path d="M12 4.5 13.8 10 19.5 12 13.8 14 12 19.5 10.2 14 4.5 12 10.2 10Z"/>',
};

const d = paths[name] ?? paths.app;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={d}
/>
