---
import Base from "../layouts/Base.astro";
import WorkflowShowcase from "../components/WorkflowShowcase.astro";
import PaletteMockup from "../components/PaletteMockup.astro";
import AppFrame from "../components/AppFrame.astro";
import Icon from "../components/Icon.astro";
import { fetchLatest } from "../data/releases";

const latest = await fetchLatest();

const platforms = [
  {
    name: "macOS",
    tag: "Apple Silicon & Intel",
    desc: "DMG disk image for Apple Silicon and Intel, or a single-command Homebrew tap.",
    command: "brew install diegoleteliers10/corvo/corvo",
    formats: "DMG · Homebrew",
    href: "https://github.com/diegoleteliers10/corvo/releases/latest",
  },
  {
    name: "Windows",
    tag: "Windows 10 / 11",
    desc: "Single-file MSI installer or portable standalone ZIP archive.",
    formats: "MSI · Portable ZIP",
    href: "https://github.com/diegoleteliers10/corvo/releases/latest",
  },
  {
    name: "Linux",
    tag: "Wayland & X11",
    desc: "Universal AppImage for any distro, or DEB package for Ubuntu and Debian.",
    formats: "AppImage · DEB",
    href: "https://github.com/diegoleteliers10/corvo/releases/latest",
  },
];
---

<Base
  title="Corvo | Native desktop launcher for macOS, Windows, and Linux"
  description="Search apps, find files, calculate math, manage windows, and run desktop actions from one keyboard-driven palette. Corvo is a native launcher written in Rust."
>
  <!-- Hero: product promise left, real capture right -->
  <section class="hero">
    <div class="hero-lamp" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <a class="hero-badge" href="/releases">
          <span class="pulse-pip" aria-hidden="true"></span>
          <span>{latest.tag}</span>
          <span class="badge-sep">/</span>
          <span class="badge-sub">open source</span>
        </a>

        <h1>
          Everyday desktop tools.
          <span class="accent-line">One native palette.</span>
        </h1>

        <p class="hero-desc">
          Corvo puts app search, file search, inline math, and system controls in one native
          palette. Press the shortcut, type a few letters, keep moving.
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary hero-btn" href="/download">
            <span>Download for free</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
          </a>

          <button
            class="install-pill"
            id="copy-install-btn"
            type="button"
            aria-label="Copy Homebrew install command to clipboard"
            data-command="brew install diegoleteliers10/corvo/corvo"
          >
            <span class="pill-prefix">$</span>
            <code>brew install diegoleteliers10/corvo/corvo</code>
            <span class="pill-copy-icon" aria-hidden="true">
              <svg class="icon-copy" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <svg class="icon-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="display:none;"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="copy-tooltip" id="copy-tooltip" role="status" aria-live="polite">Copied to clipboard</span>
          </button>
        </div>

        <div class="hero-shortcuts" aria-label="Default keyboard shortcuts">
          <span class="shortcut-item"><kbd>⌘</kbd><kbd>Space</kbd> macOS</span>
          <span class="shortcut-bullet">·</span>
          <span class="shortcut-item"><kbd>Alt</kbd><kbd>Space</kbd> Windows</span>
          <span class="shortcut-bullet">·</span>
          <span class="shortcut-item"><kbd>Super</kbd><kbd>Space</kbd> Linux</span>
        </div>
      </div>

      <div class="hero-shot">
        <AppFrame
          src="/showcase/app-search-safari.png"
          alt="Corvo launcher searching for Safari, with the app ranked first"
          eager
          variant="bare"
        />
      </div>
    </div>

    <div class="hero-availability">
      <div class="wrap avail-inner">
        <div class="avail-group">
          <span class="avail-indicator" aria-hidden="true"></span>
          <span>Available on macOS, Windows, and Linux</span>
        </div>
        <div class="avail-tags">
          <span>Homebrew</span>
          <span>DMG</span>
          <span>MSI</span>
          <span>AppImage</span>
          <span>DEB</span>
          <span>MIT</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Workflow proof: real captures -->
  <section class="section" id="workflows">
    <div class="wrap">
      <div class="section-intro">
        <h2>Type. See. Done.</h2>
        <p>
          Four everyday jobs, captured from Corvo itself. Pick a query to see exactly what the
          palette shows.
        </p>
      </div>
      <WorkflowShowcase />
    </div>
  </section>

  <!-- Interactive palette playground -->
  <section class="section playground-section" id="playground">
    <div class="wrap">
      <div class="section-intro">
        <h2>Take the palette for a spin.</h2>
        <p>
          This is a working replica of the Corvo window. Type an app name, or an arithmetic
          expression like 24 * 7, and watch the results change.
        </p>
      </div>
      <PaletteMockup />
    </div>
  </section>

  <!-- Built-in suite -->
  <section class="section bento-section" id="features">
    <div class="wrap">
      <div class="section-intro">
        <h2>One launcher. A complete toolset.</h2>
        <p>
          Every tool compiles directly into the binary. No scripting runtime. Built-in commands
          stay local to the application.
        </p>
      </div>

      <div class="bento-grid">
        <article class="bento-card span-7">
          <div class="card-visual" aria-hidden="true">
            <div class="vrow sel">
              <span class="vtile" style="background:linear-gradient(135deg, #3b82f6, #1d4ed8)">S</span>
              <span class="vtitle">Safari</span>
              <span class="vtag">Application</span>
            </div>
            <div class="vrow">
              <span class="vtile" style="background:linear-gradient(135deg, #3d434c, #17191d)">Z</span>
              <span class="vtitle">Zed</span>
              <span class="vtag">Application</span>
            </div>
            <div class="vrow">
              <span class="vtile" style="background:linear-gradient(135deg, #10a37f, #0b7a5f)">C</span>
              <span class="vtitle">ChatGPT</span>
              <span class="vtag">Application</span>
            </div>
            <div class="vrow">
              <span class="vtile" style="background:linear-gradient(135deg, #f4f4f5, #d4d4d8); color:#18181b">D</span>
              <span class="vtitle mono">~/Dev/corvo/crates/corvo-core</span>
              <span class="vtag">Directory</span>
            </div>
            <div class="vrow">
              <span class="vtile" style="background:linear-gradient(135deg, #f472b6, #be185d)">S</span>
              <span class="vtitle">Slack</span>
              <span class="vtag">Application</span>
            </div>
          </div>
          <div class="card-body">
            <span class="card-icon"><Icon name="search" size={26} /></span>
            <h3>App and file search</h3>
            <p>Fuzzy search across installed applications and filesystem paths, with frecency ranking stored locally.</p>
          </div>
        </article>

        <article class="bento-card span-5">
          <div class="card-visual" aria-hidden="true">
            <div class="vrow clip">
              <span class="vdot" style="background:#34d399"></span>
              <span class="vmono">git commit -m "fix: simd ranking"</span>
              <span class="vtime">2m</span>
            </div>
            <div class="vrow clip">
              <span class="vdot" style="background:#a78bfa"></span>
              <span class="vmono">#34d399</span>
              <span class="vtime">14m</span>
            </div>
            <div class="vrow clip">
              <span class="vdot" style="background:#6b7280"></span>
              <span class="vmono">github.com/diegoleteliers10/corvo</span>
              <span class="vtime">1h</span>
            </div>
            <div class="vrow clip">
              <span class="vdot" style="background:#34d399"></span>
              <span class="vmono">brew install diegoleteliers10/corvo/corvo</span>
              <span class="vtime">3h</span>
            </div>
          </div>
          <div class="card-body">
            <span class="card-icon"><Icon name="clipboard" size={26} /></span>
            <h3>Clipboard and snippets</h3>
            <p>Clipboard history for text, code, colors, and images, ready to paste again.</p>
          </div>
        </article>

        <article class="bento-card span-5">
          <div class="card-visual tiling" aria-hidden="true">
            <div class="mini-desktop">
              <div class="mini-win focus">
                <span class="win-dots"><i></i><i></i><i></i></span>
                <span class="win-name">Zed — SPEC.md</span>
              </div>
              <div class="mini-win">
                <span class="win-dots"><i></i><i></i><i></i></span>
                <span class="win-name mono">cargo build --release</span>
              </div>
              <div class="mini-win">
                <span class="win-dots"><i></i><i></i><i></i></span>
                <span class="win-name">Preview — localhost:4321</span>
              </div>
            </div>
            <div class="tile-keys">
              <span><kbd>⌥</kbd><kbd>⌘</kbd><kbd>←</kbd> Left</span>
              <span><kbd>⌥</kbd><kbd>⌘</kbd><kbd>→</kbd> Right</span>
              <span><kbd>⌃</kbd><kbd>⌥</kbd><kbd>↵</kbd> Maximize</span>
            </div>
          </div>
          <div class="card-body">
            <span class="card-icon"><Icon name="grid" size={26} /></span>
            <h3>Window tiling</h3>
            <p>Tile active windows into halves, thirds, or quadrants with rapid shortcuts on macOS.</p>
          </div>
        </article>

        <article class="bento-card span-7">
          <div class="card-visual" aria-hidden="true">
            <div class="vrow port">
              <span class="vport">:3000</span>
              <span class="vtitle">node (vite-dev-server)</span>
              <span class="vpid">PID 48291</span>
              <span class="vkill">Kill</span>
            </div>
            <div class="vrow port">
              <span class="vport">:8080</span>
              <span class="vtitle">cargo run (backend-api)</span>
              <span class="vpid">PID 32904</span>
              <span class="vkill">Kill</span>
            </div>
            <div class="vrow port">
              <span class="vport">:5432</span>
              <span class="vtitle">postgres (local db)</span>
              <span class="vpid">PID 28107</span>
              <span class="vkill">Kill</span>
            </div>
            <div class="vrow port">
              <span class="vport">:9222</span>
              <span class="vtitle">chromium (debug)</span>
              <span class="vpid">PID 51736</span>
              <span class="vkill">Kill</span>
            </div>
          </div>
          <div class="card-body">
            <span class="card-icon"><Icon name="sliders" size={26} /></span>
            <h3>Ports and processes</h3>
            <p>Identify hanging dev servers, inspect listening sockets, and stop stray processes from the palette.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Platforms and installation -->
  <section class="section" id="platforms">
    <div class="wrap">
      <div class="section-intro">
        <h2>Install on your system.</h2>
        <p>
          Use your package manager, or download signed release binaries straight from GitHub.
          Formats differ by platform.
        </p>
      </div>

      <div class="platforms-grid">
        {platforms.map((p) => (
          <article class="platform-card">
            <div class="platform-head">
              <h3>{p.name}</h3>
              <span class="platform-tag">{p.tag}</span>
            </div>
            <p class="platform-desc">{p.desc}</p>
            {"command" in p && (
              <div class="platform-cmd">
                <code>{p.command}</code>
              </div>
            )}
            <div class="platform-foot">
              <span class="platform-formats">{p.formats}</span>
              <a class="platform-link" href={p.href} rel="noopener" target="_blank">
                <span>Download</span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="cta-band">
    <div class="wrap cta-inner">
      <h2>Open the palette. Keep your hands on the keys.</h2>
      <div class="cta-actions">
        <a class="btn btn-primary btn-lg" href="/download">Download Corvo</a>
        <a class="btn btn-ghost btn-lg" href="https://github.com/diegoleteliers10/corvo" rel="noopener" target="_blank">View source on GitHub</a>
      </div>
      <p class="cta-facts">Rust · GPUI · MIT license · macOS, Windows, Linux</p>
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const copyBtn = document.getElementById("copy-install-btn");
    const copyTooltip = document.getElementById("copy-tooltip");
    const iconCopy = copyBtn?.querySelector(".icon-copy");
    const iconCheck = copyBtn?.querySelector(".icon-check");

    if (!copyBtn || !copyTooltip) return;

    copyBtn.addEventListener("click", async () => {
      const command = copyBtn.getAttribute("data-command") || "brew install diegoleteliers10/corvo/corvo";
      try {
        await navigator.clipboard.writeText(command);
        copyTooltip.classList.add("visible");
        if (iconCopy) iconCopy.style.display = "none";
        if (iconCheck) iconCheck.style.display = "inline-block";

        setTimeout(() => {
          copyTooltip.classList.remove("visible");
          if (iconCopy) iconCopy.style.display = "inline-block";
          if (iconCheck) iconCheck.style.display = "none";
        }, 2200);
      } catch (err) {
        console.error("Clipboard copy failed:", err);
      }
    });
  })();
</script>

<style>
  /* ---------------- Hero ---------------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(56px, 8vw, 96px) 0 0;
    border-bottom: 1px solid var(--corvo-divider);
  }

  .hero-lamp {
    position: absolute;
    top: -240px;
    left: 50%;
    transform: translateX(-50%);
    width: 1100px;
    height: 560px;
    background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(52, 211, 153, 0.14), transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
    padding-bottom: clamp(48px, 7vw, 88px);
  }

  .hero-copy {
    max-width: 560px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px 4px 10px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    color: var(--corvo-text);
    font-size: 0.78rem;
    font-family: var(--font-mono);
    margin-bottom: 26px;
    text-decoration: none;
    transition: border-color 140ms ease, background-color 140ms ease;
  }

  .hero-badge:hover {
    border-color: rgba(52, 211, 153, 0.35);
    background: rgba(255, 255, 255, 0.05);
    text-decoration: none;
  }

  .pulse-pip {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--corvo-accent);
    animation: pulse-pip 2.2s infinite;
  }

  .badge-sep {
    color: var(--corvo-text-icon);
    opacity: 0.5;
  }

  .badge-sub {
    color: var(--corvo-accent);
  }

  .hero-copy h1 {
    font-size: clamp(2.5rem, 4.6vw, 3.9rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.032em;
    margin: 0 0 20px;
  }

  .accent-line {
    display: block;
    color: var(--corvo-accent);
  }

  .hero-desc {
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.6;
    color: var(--corvo-text-dim);
    max-width: 46ch;
    margin: 0 0 30px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }

  .hero-btn {
    padding: 0.85em 1.5em;
    font-size: 1rem;
    border-radius: 10px;
  }

  .install-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%), var(--corvo-pill);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 0.72em 1.15em;
    color: var(--corvo-text);
    font-size: 0.88rem;
    cursor: pointer;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.09),
      0 2px 8px rgba(0, 0, 0, 0.3);
    transition:
      border-color 140ms ease,
      background-color 140ms ease,
      transform 120ms var(--ease-spring);
  }

  .install-pill:hover {
    border-color: rgba(52, 211, 153, 0.4);
    transform: translateY(-1px);
  }

  .install-pill:active {
    transform: scale(0.98);
  }

  .pill-prefix {
    color: var(--corvo-accent);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .install-pill code {
    background: transparent;
    border: none;
    padding: 0;
    font-size: 0.78rem;
    color: var(--corvo-text);
    white-space: nowrap;
  }

  .pill-copy-icon {
    display: inline-flex;
    color: var(--corvo-text-icon);
    margin-left: 4px;
    transition: color 140ms ease;
  }

  .install-pill:hover .pill-copy-icon {
    color: var(--corvo-accent);
  }

  .copy-tooltip {
    position: absolute;
    bottom: -34px;
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: #113c30;
    color: var(--corvo-accent);
    border: 1px solid rgba(52, 211, 153, 0.3);
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms ease, transform 160ms var(--ease-spring);
  }

  .copy-tooltip.visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .hero-shortcuts {
    display: flex;
    align-items: center;
    gap: 7px 8px;
    flex-wrap: wrap;
    color: var(--corvo-text-icon);
    font-size: 0.74rem;
  }

  .shortcut-item kbd {
    font-size: 0.7rem;
    padding: 0.14em 0.42em;
  }

  .shortcut-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .shortcut-bullet {
    opacity: 0.4;
  }

  .hero-shot {
    min-width: 0;
  }

  .hero-availability {
    position: relative;
    padding: 16px 0;
    border-top: 1px solid var(--corvo-divider);
    font-size: 0.82rem;
    color: var(--corvo-text-dim);
    background: rgba(23, 24, 26, 0.5);
  }

  .avail-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .avail-group {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
  }

  .avail-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--corvo-accent);
  }

  .avail-tags {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--corvo-text-icon);
  }

  .avail-tags span {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 2px 8px;
    border-radius: 4px;
  }

  /* ---------------- Sections ---------------- */
  .section {
    padding: var(--section-y) 0;
    border-top: 1px solid var(--corvo-divider);
  }

  .section-intro {
    max-width: 640px;
    margin-bottom: clamp(36px, 6vw, 60px);
  }

  .section-intro h2 {
    margin: 0 0 14px;
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .section-intro p {
    font-size: 1.02rem;
    line-height: 1.6;
    margin: 0;
  }

  .playground-section {
    background: linear-gradient(180deg, var(--corvo-surface) 0%, var(--corvo-bg) 100%);
  }

  /* ---------------- Bento ---------------- */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 22px;
  }

  .span-7 { grid-column: span 7; }
  .span-5 { grid-column: span 5; }

  .bento-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 400px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02) 0%, rgba(0, 0, 0, 0.16) 100%), var(--corvo-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms var(--ease-out);
  }

  .bento-card:hover {
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.45);
    transform: translateY(-2px);
  }

  .card-visual {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 24px 24px 10px;
    margin: 0;
    -webkit-mask-image: linear-gradient(180deg, #000 58%, transparent 99%);
    mask-image: linear-gradient(180deg, #000 58%, transparent 99%);
  }

  .card-visual.tiling {
    gap: 14px;
    -webkit-mask-image: linear-gradient(180deg, #000 78%, rgba(0, 0, 0, 0.45) 100%);
    mask-image: linear-gradient(180deg, #000 78%, rgba(0, 0, 0, 0.45) 100%);
  }

  .vrow {
    display: flex;
    align-items: center;
    gap: 13px;
    min-height: 50px;
    padding: 0 16px;
    border-radius: 12px;
