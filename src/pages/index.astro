---
import Base from "../layouts/Base.astro";
import PaletteMockup from "../components/PaletteMockup.astro";
import FeatureList from "../components/FeatureList.astro";
import DemoTabs from "../components/DemoTabs.astro";
import DownloadButtons from "../components/DownloadButtons.astro";
import KeyCap from "../components/KeyCap.astro";

const features = [
  { icon: "app", title: "App Launcher", body: "Fuzzy search with frecency ranking. The apps you use rise to the top." },
  { icon: "grid", title: "Window Management", body: "Tile into halves, thirds, and quarters. Gaps and layout templates included." },
  { icon: "clipboard", title: "Clipboard History", body: "Text, code, colors, and images. Searchable, with configurable retention." },
  { icon: "calc", title: "Calculator", body: "Evaluate expressions inline and keep a calculation history." },
  { icon: "snippet", title: "Snippets", body: "Insert text templates by keyword, git-diffable TOML under the hood." },
  { icon: "emoji", title: "Emoji Picker", body: "Search emojis by name with skin-tone selection." },
  { icon: "link", title: "Quicklinks", body: "Open custom URLs and web searches from the palette." },
  { icon: "search", title: "File Search", body: "Find files with configurable scopes and ignore rules." },
  { icon: "sliders", title: "System Actions", body: "Dark mode, audio, displays, and settings panels. No digging through menus." },
  { icon: "refresh", title: "Auto-Updater", body: "Signature-verified update checks. You decide when to install." },
];

const facts = [
  { k: "Language", v: "Rust, one native binary per OS" },
  { k: "UI", v: "GPUI, no embedded browser" },
  { k: "Search", v: "SIMD fuzzy matching, first-keystroke results" },
  { k: "Storage", v: "LMDB, no background services" },
];
---

<Base
  title="Corvo — The native launcher for macOS, Linux, and Windows"
  description="Corvo is a free, open-source launcher written in Rust. Apps, clipboard, windows, and system actions behind one keystroke."
>
  <section class="hero">
    <div class="mark" aria-hidden="true"></div>
    <div class="wrap">
      <h1>One keystroke<span class="dot">.</span><br />Everything on your machine<span class="dot">.</span></h1>
      <p class="lede">
        Corvo is a native launcher written in Rust. Launch apps, search files,
        manage windows, and control your system from a single palette on
        macOS, Linux, and Windows.
      </p>
      <div class="cta">
        <DownloadButtons />
        <a
          class="btn btn-ghost"
          href="https://github.com/diegoleteliers10/corvo"
          rel="noopener"
          target="_blank">View source</a
        >
      </div>
      <p class="hint">Summon it from anywhere with <KeyCap keys={["⌥", "Space"]} /> — free and open source, MIT.</p>
      <div class="shot">
        <PaletteMockup />
      </div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="track">
      {
        [0, 1].map(() => (
          <div class="group">
            {[
              ...features.map((f) => f.title),
              "kill-process",
              "brew",
              "pomodoro",
              "weather",
              "notes",
              "media-control",
              "browser-tabs",
            ].map((name) => (
              <span class="titem">
                <span class="tname">{name}</span>
                <span class="tsep">·</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Everything at your keystroke</h2>
        <p>Ten core commands ship in the box. No accounts, no telemetry, no helper processes.</p>
      </div>
      <FeatureList features={features} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>See it work</h2>
        <p>Real layout, real palette — the same surface you will use every day.</p>
      </div>
      <DemoTabs />
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="split-copy">
        <h2>Built like a system tool</h2>
        <p>
          Corvo has no runtime plugin system and no embedded browser. Every
          command is compiled Rust, so the palette stays as light as the day
          you installed it.
        </p>
        <p>
          Search results appear on the first keystroke thanks to SIMD fuzzy
          matching, and history lives in LMDB, the storage engine behind some
          of the fastest databases in production.
        </p>
        <a href="/features">Read about the architecture →</a>
      </div>
      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>More commands, compiled in</h2>
        <p>
          New commands land as native crates registered at link time. This
          batch is in development.
        </p>
      </div>
      <div class="chips">
        <span class="chip">kill-process</span>
        <span class="chip">brew</span>
        <span class="chip">text-utilities</span>
        <span class="chip">pomodoro</span>
        <span class="chip">weather</span>
        <span class="chip">notes</span>
        <span class="chip">media-control</span>
        <span class="chip">browser-tabs</span>
      </div>
      <p class="legend">Track progress in the repository, or propose a command of your own.</p>
      <p style="margin-top: var(--s5);"><a href="/extensions">See the extension roadmap →</a></p>
    </div>
  </section>

  <section class="section cta-band">
    <div class="band-mark" aria-hidden="true"></div>
    <div class="wrap center">
      <h2>Get Corvo</h2>
      <p class="lede" style="margin-bottom: var(--s6);">Installers for Apple Silicon, Intel, Linux, and Windows.</p>
      <div class="cta center-cta">
        <DownloadButtons />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(72px, 10vw, 128px) 0 var(--s8);
    background:
      radial-gradient(55% 42% at 50% 0%, color-mix(in srgb, var(--corvo-accent) 8%, transparent), transparent),
      var(--corvo-bg);
  }
  .hero .wrap {
    position: relative;
  }
  .mark {
    position: absolute;
    top: -90px;
    right: -80px;
    width: min(52vw, 580px);
    aspect-ratio: 313 / 234;
    background: url("/brand/corvo-mark.png") center / contain no-repeat;
    mix-blend-mode: screen;
    opacity: 0.42;
    transform: rotate(-6deg);
    pointer-events: none;
    user-select: none;
  }
  .dot {
    color: var(--corvo-accent);
  }
  .shot {
    margin-top: clamp(40px, 6vw, 64px);
    perspective: 1200px;
  }
  .shot :global(.palette) {
    will-change: transform;
  }

  /* command ticker */
  .ticker {
    border-block: 1px solid var(--corvo-divider);
    background: var(--corvo-surface);
    overflow: hidden;
    padding: 14px 0;
  }
  .track {
    display: flex;
    width: max-content;
    animation: ticker 48s linear infinite;
  }
  .ticker:hover .track {
    animation-play-state: paused;
  }
  .group {
    display: flex;
    align-items: center;
  }
  .titem {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .tname {
    color: var(--corvo-text-dim);
  }
  .tsep {
    color: var(--corvo-accent);
    padding: 0 18px;
    opacity: 0.7;
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  .lede {
    max-width: 52ch;
  }
  .cta {
    display: flex;
    gap: var(--s3);
    flex-wrap: wrap;
    align-items: center;
    margin: var(--s6) 0 var(--s4);
  }
  .hint {
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin: 0;
  }
  .shot {
    margin-top: clamp(40px, 6vw, 64px);
  }
  .split {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--s8);
    align-items: center;
  }
  .split-copy p {
    max-width: 52ch;
  }
  .facts {
    margin: 0;
  }
  .facts > div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: var(--s4);
    padding: var(--s4) 0;
    border-top: 1px solid var(--corvo-divider);
  }
  .facts > div:last-child {
    border-bottom: 1px solid var(--corvo-divider);
  }
  dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--corvo-text-icon);
    padding-top: 3px;
  }
  dd {
    margin: 0;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    border-radius: 99px;
    padding: 5px 13px;
    border: 1px solid var(--corvo-divider);
    background: var(--corvo-pill);
    color: var(--corvo-text-dim);
    transition: border-color 140ms ease, color 140ms ease;
  }
  .chip:hover {
    color: var(--corvo-accent);
    border-color: color-mix(in srgb, var(--corvo-accent) 30%, var(--corvo-divider));
  }
  .legend {
    font-size: 0.85rem;
    color: var(--corvo-text-icon);
    margin-top: var(--s4);
  }
  .cta-band {
    position: relative;
    overflow: hidden;
    background: var(--corvo-surface);
    padding: calc(var(--section-y) * 1.12) 0;
  }
  .cta-band h2 {
    font-size: clamp(2.1rem, 4.5vw, 3.2rem);
  }
  .band-mark {
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(46vw, 380px);
    aspect-ratio: 313 / 234;
    background: url("/brand/corvo-mark.png") center / contain no-repeat;
    mix-blend-mode: screen;
    opacity: 0.4;
    transform: rotate(-6deg);
    pointer-events: none;
  }
  .cta-band .wrap {
    position: relative;
  }
  @media (max-width: 640px) {
    .mark {
      opacity: 0.3;
      width: 92vw;
      top: -30px;
      right: -130px;
    }
  }
  .center {
    text-align: center;
  }
  .center-cta {
    justify-content: center;
    margin: 0;
  }
  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
      gap: var(--s7);
    }
  }
</style>

<script>
  // Subtle 3D tilt on the launcher mockup. Decorative: hover-capable
  // pointers only, honors reduced motion, smoothed with a small lerp.
  const stage = document.querySelector<HTMLElement>(".shot");
  const card = stage?.querySelector<HTMLElement>(".palette");
  const fine =
    matchMedia("(hover: hover) and (pointer: fine)").matches &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (stage && card && fine) {
    let raf = 0;
    let tx = 0;
    let ty = 0;
    let cx = 0;
    let cy = 0;

    const loop = () => {
      cx += (tx - cx) * 0.12;
      cy += (ty - cy) * 0.12;
      card.style.transform = `perspective(1200px) rotateX(${cy.toFixed(2)}deg) rotateY(${cx.toFixed(2)}deg)`;
      if (Math.abs(tx - cx) > 0.02 || Math.abs(ty - cy) > 0.02) {
        raf = requestAnimationFrame(loop);
      } else {
        raf = 0;
      }
    };

    stage.addEventListener("pointermove", (e) => {
      const r = stage.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width - 0.5) * 6;
      ty = -((e.clientY - r.top) / r.height - 0.5) * 4;
      if (!raf) raf = requestAnimationFrame(loop);
    });

    stage.addEventListener("pointerleave", () => {
      tx = 0;
      ty = 0;
      if (!raf) raf = requestAnimationFrame(loop);
    });
  }
</script>
