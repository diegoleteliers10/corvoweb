---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Corvo" description="Page not found.">
  <section class="section">
    <div class="wrap center">
      <h1>Page not found</h1>
      <p>The address does not exist. Head back to the palette.</p>
      <p style="margin-top: var(--s5);"><a class="btn btn-primary" href="/">Go home</a></p>
    </div>
  </section>
</Base>

<style>
  .center {
    text-align: center;
    padding-top: var(--s8);
  }
  .center p {
    margin-left: auto;
    margin-right: auto;
  }
</style>
