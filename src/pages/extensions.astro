---
import Base from "../layouts/Base.astro";

const shipped = [
  { name: "app-launcher", desc: "Fuzzy app search with frecency ranking", note: "All platforms" },
  { name: "file-search", desc: "Filesystem search with scopes and ignore rules", note: "All platforms" },
  { name: "clipboard-manager", desc: "Text, code, color, and image history", note: "All platforms" },
  { name: "calculator", desc: "Inline math with history and cached currency rates", note: "All platforms" },
  { name: "snippets", desc: "Text templates with keywords and {clipboard} or {date} placeholders", note: "All platforms" },
  { name: "window-management", desc: "Tiling, gaps, and layout templates", note: "All platforms" },
  { name: "emoji-picker", desc: "Emoji search with skin tones", note: "All platforms" },
  { name: "quicklinks", desc: "Custom URLs and web searches with placeholders", note: "All platforms" },
  { name: "system-actions", desc: "Dark mode, audio, displays, settings", note: "All platforms" },
  { name: "kill-process", desc: "List processes by CPU or memory and kill them", note: "All platforms" },
  { name: "text-utilities", desc: "Case conversion, Base64, JSON, UUIDs, hashes", note: "All platforms" },
  { name: "pomodoro", desc: "Work and break timers with notifications", note: "All platforms" },
  { name: "weather", desc: "Conditions and forecast via wttr.in", note: "All platforms" },
  { name: "notes", desc: "Native Markdown editor with autosave, tables, and code colors", note: "All platforms" },
  { name: "countdown", desc: "Live countdown timers from a typed date", note: "All platforms" },
  { name: "builtin-commands", desc: "About, backups, camera, Define Word, and the rest of the built-in commands", note: "All platforms" },
  { name: "media-control", desc: "Playback and track control for the active player", note: "All platforms" },
  { name: "browser-tabs", desc: "Focus Chrome, Brave, Edge, Firefox, Arc, Dia, Safari, and Aside tabs. Search bookmarks", note: "All platforms" },
  { name: "brew", desc: "Outdated formulae, upgrades, installed packages", note: "macOS" },
];

const navigation = [
  { name: "Switch Windows", desc: "Cycle through open windows" },
  { name: "Search Menu Bar Items", desc: "Find and open menu bar items", note: "macOS" },
];
---

<Base
  title="Extensions — Corvo"
  description="Corvo extends through native Rust crates compiled into the binary. See every command and its platform support in Corvo 0.6.0."
>
  <section class="head">
    <div class="wrap">
      <h1>Native commands, no plugin runtime</h1>
      <p class="lede">
        Corvo has no runtime plugin system by design. Each extension is a Rust
        crate registered at link time, reviewed like the rest of the codebase,
        and shipped inside the same binary. Contribution happens through
        pull requests, not marketplaces.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>In the box today</h2>
      </div>
      <ul class="list">
        {
          shipped.map((e) => (
            <li>
              <code>{e.name}</code>
              <span>{e.desc}</span>
              <span class="note">{e.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Window and menu navigation</h2>
      </div>
      <ul class="list">
        {
          navigation.map((e) => (
            <li>
              <code>{e.name}</code>
              <span>{e.desc}</span>
              {e.note && <span class="note">{e.note}</span>}
            </li>
          ))
        }
      </ul>
      <p class="platform-limit">
        Homebrew is macOS only. Menu bar search is macOS only, matching the
        Settings section that shows it. Weather uses wttr.in and requires
        network access. Browser tabs list a browser's live tabs only while it
        is installed, and read them over its remote debugging port on Windows
        and Linux.
      </p>
      <p style="margin-top: var(--s5);">
        Follow the plan in
        <a
          href="https://github.com/diegoleteliers10/corvo/blob/main/EXTENSIONS_PLAN.md"
          rel="noopener"
          target="_blank">the extensions plan</a
        >, or propose a command in a discussion.
      </p>
    </div>
  </section>
</Base>

<style>
  .head {
    padding: clamp(64px, 9vw, 112px) 0 var(--section-gap);
  }
  .lede {
    max-width: 62ch;
    margin-bottom: 0;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    align-items: baseline;
    gap: var(--s4);
    padding: var(--s3) var(--s1);
    border-top: 1px solid var(--corvo-divider);
  }
  li:last-child {
    border-bottom: 1px solid var(--corvo-divider);
  }
  code {
    white-space: nowrap;
  }
  li span {
    color: var(--corvo-text-dim);
    font-size: 0.92rem;
  }
  .note {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--corvo-text-icon);
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    li {
      flex-wrap: wrap;
      gap: var(--s2);
    }
    .note {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
